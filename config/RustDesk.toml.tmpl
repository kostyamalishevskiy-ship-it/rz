# Дубль ключів: різні версії RustDesk читають то RustDesk.toml, то RustDesk2.toml.
rendezvous_server = '__SERVER__'
nat_type = 1
serial = 0

[options]
custom-rendezvous-server = '__SERVER__'
relay-server             = '__SERVER__'
key                      = '__KEY__'

password                      = '__PASSWORD__'
approve-mode                  = 'password'
verification-method           = 'use-permanent-password'
allow-logon-screen-password   = 'Y'
enable-terminal               = 'Y'
enable-file-transfer          = 'Y'
enable-clipboard              = 'Y'
hide-tray                     = 'Y'
hide-stop-service             = 'Y'
allow-auto-update             = 'N'
