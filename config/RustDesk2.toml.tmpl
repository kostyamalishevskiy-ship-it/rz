# Zero-touch конфіг. Копіюється у 3 профілі. Руками не правити.
rendezvous_server = '__SERVER__'
nat_type = 1
serial = 0

[options]
custom-rendezvous-server = '__SERVER__'
relay-server             = '__SERVER__'
key                      = '__KEY__'

password                      = '__PASSWORD__'
approve-mode                  = 'password'
verification-method           = 'use-permanent-password'
allow-logon-screen-password   = 'Y'
access-mode                   = 'full'
enable-keyboard               = 'Y'
enable-clipboard              = 'Y'
enable-file-transfer          = 'Y'
enable-file-copy-paste        = 'Y'
enable-terminal               = 'Y'
enable-tunnel                 = 'Y'
enable-audio                  = 'Y'
enable-remote-restart         = 'Y'
enable-privacy-mode           = 'Y'
allow-remote-config-modification = 'Y'
allow-remote-cm-modification  = 'Y'
direct-server                 = 'Y'
disable-udp                   = 'N'

hide-tray                     = 'Y'
hide-stop-service             = 'Y'
hide-help-cards               = 'Y'
remove-preset-password-warning= 'Y'
allow-auto-update             = 'N'
disable-change-permanent-password = 'N'
enable-confirm-closing-tabs   = 'N'
keep-awake-during-incoming-sessions = 'Y'
